# ── Frontend Environment Variables ──
# VITE_-prefixed vars are inlined into client bundles at build time.
# They are browser-visible. NEVER put secrets here.

# API base URL for backend communication.
# For local dev (Vite): http://localhost:3000
# For Docker + Caddy: http://localhost (or empty for same-origin)
# For production: https://your-domain.com
VITE_API_BASE_URL=http://localhost:3000

# API path prefix (default /api)
VITE_API_PREFIX=/api
